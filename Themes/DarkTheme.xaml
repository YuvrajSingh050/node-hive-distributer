<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════
         COLOR PALETTE
    ════════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="BgColor">#FF070a0f</Color>
    <Color x:Key="PanelColor">#FF0d1117</Color>
    <Color x:Key="AccentColor">#FF00f5c4</Color>
    <Color x:Key="BorderColor">#FF1e2833</Color>
    <Color x:Key="TextColor">#FFe6edf3</Color>
    <Color x:Key="MutedColor">#FF8b949e</Color>
    <Color x:Key="HeaderBg">#FF0a0f16</Color>

    <SolidColorBrush x:Key="BgBrush"      Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush"   Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="AccentBrush"  Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BorderBrush"  Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush"    Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush"   Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="{StaticResource HeaderBg}"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PANEL CARD STYLE (Border)
    ════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="Background"       Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="CornerRadius"     Value="6"/>
        <Setter Property="Padding"          Value="14,10"/>
    </Style>

    <!-- Panel label (e.g. "// NODE A") -->
    <Style x:Key="PanelLabel" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Consolas"/>
        <Setter Property="FontSize"    Value="10"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
        <Setter Property="Opacity"     Value="0.85"/>
        <Setter Property="Margin"      Value="0,0,0,6"/>
    </Style>

    <!-- Body text inside panels -->
    <Style x:Key="PanelText" TargetType="TextBlock">
        <Setter Property="FontFamily"    Value="Consolas"/>
        <Setter Property="FontSize"      Value="12"/>
        <Setter Property="Foreground"    Value="{StaticResource TextBrush}"/>
        <Setter Property="TextWrapping"  Value="Wrap"/>
        <Setter Property="LineHeight"    Value="20"/>
    </Style>

    <!-- Dim / muted text -->
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="Consolas"/>
        <Setter Property="FontSize"    Value="10"/>
        <Setter Property="Foreground"  Value="{StaticResource MutedBrush}"/>
        <Setter Property="LineHeight"  Value="18"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         PROGRESS BAR
    ════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="NodeProgressBar" TargetType="ProgressBar">
        <Setter Property="Height"     Value="4"/>
        <Setter Property="Background" Value="#FF1a2332"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Minimum"    Value="0"/>
        <Setter Property="Maximum"    Value="100"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2"/>
                        <Border x:Name="PART_Track" CornerRadius="2"/>
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2"
                                HorizontalAlignment="Left">
                            <Border.Effect>
                                <DropShadowEffect Color="#00f5c4" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CUSTOM TITLE BAR BUTTON (minimize / close)
    ════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width"            Value="40"/>
        <Setter Property="Height"           Value="32"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Foreground"       Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontFamily"       Value="Consolas"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22ffffff"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#44ffffff"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close button variant (red on hover) -->
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C0ff4444"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFff2222"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════════
         SCROLLVIEWER (thin dark scrollbar)
    ════════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width"      Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#442a3a30" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
